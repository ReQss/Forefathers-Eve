  dialogueLines:
  - text: Welcome to our village!
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
  - text: Try anything and I will stab you!
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 38356a3297e4cda47b0141bdb18915cd, type: 3}
  - text: Hello handsome man.
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 35814de485744bd4ea39cc78d5021321, type: 3}
  - text: Hi...
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 6be477f9100b8c0478ead771d7c1a79a, type: 3}
  - text: Whats your purpose of staying here?
    characterName: Mayor
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
  ghostName: Duch
  isMultipleChoice: 1
  multipleChoice:
    choiceDescription: What's your purpose of coming here?
    choices:
    - choiceText: I am here to take care of this old place..
      correctness: 1
      afterChoiceDialogue: {fileID: 11400000, guid: 4dfb542aec85c124fa43f688c48a9b08, type: 2}
