  m_Script: {fileID: 11500000, guid: d648cd2f634e7f84ab5173ca253cbecf, type: 3}
  m_Name: 2Bad
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: Sir.. Are you sure you saw the ghosts? Ghost are not real
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: I think you say heresies.. That's not something anyone should say in front
      of church messenger
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: I... I am sorry.. Maybe I was wrong
    characterName: Farmer
    characterPortrait: {fileID: 21300000, guid: 38356a3297e4cda47b0141bdb18915cd, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: Maybe you are church messenger but light in the forest is not something
      someone could mistake..
    characterName: Mayor
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: If it happens next time we will have to take investigation into your work..
    characterName: Mayor
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
    dialogueAudioClip: {fileID: 0}
  ghostName: Duch
  isMultipleChoice: 0
