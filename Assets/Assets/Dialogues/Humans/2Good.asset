  m_Script: {fileID: 11500000, guid: d648cd2f634e7f84ab5173ca253cbecf, type: 3}
  m_Name: 2Good
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: I am sorry sir.. I am just a poor sheephard.. I just got lost in the forest
      since it was my first day..
    characterName: Bogdan
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: That.. Explain the light inside the forest.. BUT! THE GHOST! I SAW IT!
    characterName: Farmer
    characterPortrait: {fileID: 21300000, guid: 38356a3297e4cda47b0141bdb18915cd, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: Yes.. I was helping young boy.. He got lost after coming to the church..
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: .. Excelent work! Thank you for your service in that case
    characterName: Mayor
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
    dialogueAudioClip: {fileID: 0}
  - text: I will take this farmer and scold him for his words
    characterName: Mayor
    characterPortrait: {fileID: 21300000, guid: 09b90f90b051f8e4eaafd32d657783bf, type: 3}
    dialogueAudioClip: {fileID: 0}
  ghostName: Duch
  isMultipleChoice: 0
