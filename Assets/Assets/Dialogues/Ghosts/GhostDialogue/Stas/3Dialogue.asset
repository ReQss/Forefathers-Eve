%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d648cd2f634e7f84ab5173ca253cbecf, type: 3}
  m_Name: 3Dialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "The child's spirit shudders as the mist thickens around you both. The
      cold intensifies, seeping through your clothes like unseen fingers. \r"
    characterName: 
    characterPortrait: {fileID: 0}
  - text: You shouldn't have come.
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 6559986750687620480, guid: f6bf9118621e98e45a82d4d131bfedd3, type: 3}
  - text: The thing's lipless mouth twists in what might be amusement. Its grip tightens
      around the child's torso, pulling him back slightly.
    characterName: 
    characterPortrait: {fileID: 0}
  - text: Let him go.
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: The creature's eye rolls toward you, flickering like candlelight behind
      storm glass.
    characterName: 
    characterPortrait: {fileID: 0}
  - text: The little one... belongs to the dark now. His promises... they don't mean
      anything here. You can't... take what isn't... yours to take.
    characterName: 
    characterPortrait: {fileID: 2229773070677313066, guid: 55bc7a16c257c4842b81e667b5ebcb97, type: 3}
  - text: He was never meant for this place. His soul... it's pure. You've got no
      claim here.
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: The thing's head tilts, eye narrowing as it observes you.
    characterName: 
    characterPortrait: {fileID: 2229773070677313066, guid: 55bc7a16c257c4842b81e667b5ebcb97, type: 3}
  - text: Pure... (it says the word as if tasting something sour) Pure things...
      rot faster in the dark. The child wanted to be remembered. That's why he stayed.
    characterName: 
    characterPortrait: {fileID: 2229773070677313066, guid: 55bc7a16c257c4842b81e667b5ebcb97, type: 3}
  - text: I didn't mean to... I just wanted them to know I was here...
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 2229773070677313066, guid: 55bc7a16c257c4842b81e667b5ebcb97, type: 3}
  - text: "And you are. You're here now. (You step closer, ignoring the cold that
      bites at your boots.) Whatever you promised, whatever you lost\u2014it doesn't
      have to trap you."
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: Everything traps us, little light-bringer. That's how it works here. If
      you want to let the child go you have to give something in return..
    characterName: 
    characterPortrait: {fileID: 2229773070677313066, guid: 55bc7a16c257c4842b81e667b5ebcb97, type: 3}
  - text: 'I have no interest in being trapped here myself. But I will give what
      is needed if it means freeing this child.

'
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: The thing's mouth stretches into something resembling a smile, revealing
      rows of broken, jagged teeth.
    characterName: 
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  ghostName: 
  isMultipleChoice: 1
  multipleChoice:
    choiceDescription: Should I sign the pact with the creature and sacrifice myself?
    choices:
    - choiceText: It's.. to risky.. I should not accept creature offer
      correctness: 2
      afterChoiceDialogue: {fileID: 11400000, guid: 2becc067def6fc64b89785e4b1309c83, type: 2}
    - choiceText: 'Decide to sacrifice yourself for the boy '
      correctness: 1
      afterChoiceDialogue: {fileID: 11400000, guid: 26df95a1403833347ad2b15a790fa48e, type: 2}
  defaultGhostPortrait: {fileID: 0}
  startNextDialogueAutomatically: 1
  spawnEnemy: 0
  setPlayerHealthToOne: 1
