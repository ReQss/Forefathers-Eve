  m_Script: {fileID: 11500000, guid: d648cd2f634e7f84ab5173ca253cbecf, type: 3}
  m_Name: 2Dialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: (...)
    characterName: 
    characterPortrait: {fileID: 0}
  - text: (...)
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 6559986750687620480, guid: f6bf9118621e98e45a82d4d131bfedd3, type: 3}
  - text: "\rA promise... made in the dark... That's something. Tell me more."
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: I... I think... someone asked me to wait. Wait for them. Said they would
      come back. But they didn't... and now I don't know who I am anymore.
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 6559986750687620480, guid: f6bf9118621e98e45a82d4d131bfedd3, type: 3}
  - text: ' (softly) Who asked you to wait?'
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: I... can't see them. They were... warm. But the dark swallowed them. I
      stayed. I always stay.
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 6559986750687620480, guid: f6bf9118621e98e45a82d4d131bfedd3, type: 3}
  - text: It's all right. You can let go now. The one you waited for... maybe they
      rest already
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: 'You speak as if rest is something I can choose... but it doesn''t come.

'
    characterName: "Sta\u015B"
    characterPortrait: {fileID: 6559986750687620480, guid: f6bf9118621e98e45a82d4d131bfedd3, type: 3}
  - text: "The mist around the spirit flickers. Its shape wavers between human and
      vapor. You sense cold against your skin, but not sharp\u2014just a quiet ache."
    characterName: 
    characterPortrait: {fileID: 0}
  - text: 'W-Who are you? A voice in the dark? '
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  ghostName: 
  isMultipleChoice: 0
  multipleChoice:
    choiceDescription: 
    choices: []
  defaultGhostPortrait: {fileID: 0}
  startNextDialogueAutomatically: 1
