  m_Script: {fileID: 11500000, guid: d648cd2f634e7f84ab5173ca253cbecf, type: 3}
  m_Name: StartRitualDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: Darkness around. Dullness around. What will be now? What will be now?
    characterName: Choir
    characterPortrait: {fileID: 0}
  - text: The Pellar entered the chapel, ordering its doors locked. Hurrying people
      to quench the candles.
    characterName: 
    characterPortrait: {fileID: 0}
  - text: 'Darkness around. Dullness around. What will be now? What will be now?

'
    characterName: Choir
    characterPortrait: {fileID: 0}
  - text: "The people gathered around a coffin, and the Pellar started his rites\r\n\r"
    characterName: 
    characterPortrait: {fileID: 0}
  - text: 'The souls of Purgatory! In any side of the world: whether you are burning
      in tar, freezing at the bottom of a brook, or for a severer punishment you
      are implanted into austere wood, while being bit by embers of a stove you cry
      mournfully and moan. '
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: "Each of you hurry to join our herd! Let the herd meet. We are having Forefathers\u2019
      Eve!"
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: Descend into the holy place; where the alms, prayers, food and beverages
      await.
    characterName: Pellar
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: Darkness around. Dullness around. What will be now? What will be now?
    characterName: Choir
    characterPortrait: {fileID: 21300000, guid: 0a52251274713e64a9b2200db7aed0bb, type: 3}
  - text: In the background.. There are sounds of the ghost approaching..
    characterName: 
    characterPortrait: {fileID: 0}
  ghostName: 
  isMultipleChoice: 0
  multipleChoice:
    choiceDescription: 
    choices: []
  defaultGhostPortrait: {fileID: 0}
  startNextDialogueAutomatically: 1
